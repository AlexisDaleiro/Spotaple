{
  "expo": {
    "name": "Spotaple",
    "slug": "spotaple",
    "version": "0.2.2",
    "icon": "./brand.png",
    "platforms": ["android"],
    "android": {
      "package": "com.alexis.spotaple.preview",
      "adaptiveIcon": {
        "foregroundImage": "./brand.png",
        "backgroundColor": "#0c0d0f"
      },
      "versionCode": 4,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ]
    ]
  }
}
