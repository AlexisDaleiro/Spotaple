{
  "name": "spotaple",
  "productName": "Spotaple",
  "version": "0.1.0",
  "description": "Reproductor de música de escritorio, local y personal, con streaming vía YouTube.js",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Alexis Daleiro",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:ui": "node scripts/e2e-ui.mjs",
    "a11y": "node scripts/a11y.mjs",
    "check:youtube": "node scripts/probe.mjs",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win",
    "check:jam": "node scripts/jam-probe.mjs",
    "check:relay": "node scripts/check-relay.mjs",
    "e2e:jam": "node scripts/e2e-jam.mjs",
    "relay:node": "node scripts/relay-node.mjs"
  },
  "build": {
    "appId": "com.alexis.spotaple",
    "productName": "Spotaple",
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
