{
  "name": "spotaple",
  "productName": "Spotaple",
  "version": "0.1.4",
  "description": "Reproductor de música de escritorio, local y personal, con streaming vía YouTube.js",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Alexis Daleiro",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:ui": "node scripts/e2e-ui.mjs",
    "e2e:settings": "node scripts/e2e-settings.mjs",
    "e2e:playlists": "node scripts/e2e-playlists.mjs",
    "e2e:radio": "node scripts/e2e-radio.mjs",
    "e2e:offline": "node scripts/e2e-offline.mjs",
    "e2e:foryou": "node scripts/e2e-foryou.mjs",
    "e2e:audio": "node scripts/e2e-audio.mjs",
    "a11y": "node scripts/a11y.mjs",
    "check:youtube": "node scripts/probe.mjs",
    "pack": "npm run prepare:relay && electron-vite build && electron-builder --dir",
    "dist": "npm run prepare:relay && electron-vite build && electron-builder --win",
    "dist:installer": "npm run prepare:relay && electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist:store": "node scripts/build-windows-store.mjs",
    "dist:mac:preview": "npm run prepare:relay && electron-vite build && electron-builder --mac dmg --publish never -c.mac.identity=-",
    "prepare:relay": "node scripts/prepare-relay.mjs",
    "check:jam": "node scripts/jam-probe.mjs",
    "check:relay": "node scripts/check-relay.mjs",
    "e2e:jam": "node scripts/e2e-jam.mjs",
    "relay:node": "node scripts/relay-node.mjs"
  },
  "build": {
    "appId": "com.alexis.spotaple",
    "productName": "Spotaple",
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "jam-relay",
        "filter": [
          "relay/wrangler.toml",
          "relay/src/worker.ts",
          "relay/src/wrangler-electron.cjs",
          "relay/node_modules/**",
          "src/shared/**"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "artifactName": "Spotaple-${version}-mac-${arch}.dmg",
      "category": "public.app-category.music"
    },
    "nsis": {
      "artifactName": "Spotaple-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "AlexisDaleiro",
      "repo": "Spotaple"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
